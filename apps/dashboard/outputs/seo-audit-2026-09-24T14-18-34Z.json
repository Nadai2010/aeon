        "href": "https://www.aeon.fun/architecture"
      }
    },
    "link_transparency": {
      "type": "StoryLink",
      "props": {
        "title": "/transparency",
        "href": "https://www.aeon.fun/transparency"
      }
    },
    "link_ecosystem": {
      "type": "StoryLink",
      "props": {
        "title": "/ecosystem",
        "href": "https://www.aeon.fun/ecosystem"
      }
    },
    "link_developers": {
      "type": "StoryLink",
      "props": {
        "title": "/developers",
        "href": "https://www.aeon.fun/developers"
      }
    },
    "link_blog": {
      "type": "StoryLink",
      "props": {
        "title": "/blog",
        "href": "https://www.aeon.fun/blog"
      }
    },
    "link_audits": {
      "type": "StoryLink",
      "props": {
        "title": "/audits",
        "href": "https://www.aeon.fun/audits"
      }
    },
    "link_changelog": {
      "type": "StoryLink",
      "props": {
        "title": "/changelog",
        "href": "https://www.aeon.fun/changelog"
      }
    },
    "link_about": {
      "type": "StoryLink",
      "props": {
        "title": "/about",
        "href": "https://www.aeon.fun/about"
      }
    },
    "link_contact": {
      "type": "StoryLink",
      "props": {
        "title": "/contact",
        "href": "https://www.aeon.fun/contact"
      }
    },
    "link_privacy": {
      "type": "StoryLink",
      "props": {
        "title": "/privacy",
        "href": "https://www.aeon.fun/privacy"
      }
    },
    "link_terms": {
      "type": "StoryLink",
      "props": {
        "title": "/terms",
        "href": "https://www.aeon.fun/terms"
      }
    },
    "sep_3": {
      "type": "Separator",
      "props": {}
    },
    "section_fix": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_fix",
        "fix_rec_1",
        "fix_rec_2"
      ]
    },
    "heading_fix": {
      "type": "Heading",
      "props": {
        "text": "Recommended Fixes",
        "level": "h2"
      }
    },
    "fix_rec_1": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "text_rec_1a",
        "link_rec_1",
        "text_rec_1b"
      ]
    },
    "text_rec_1a": {
      "type": "Text",
      "props": {
        "text": "Relist"
      }
    },
    "link_rec_1": {
      "type": "Link",
      "props": {
        "label": "https://www.aeon.fun/",
        "href": "https://www.aeon.fun/"
      }
    },
    "text_rec_1b": {
      "type": "Text",
      "props": {
        "text": "as the canonical sitemap entry"
      }
    },
    "fix_rec_2": {
      "type": "Text",
      "props": {
        "text": "Add the 14 missing pages to the sitemap so Google can discover them via sitemap.xml."
      }
    }
  }
