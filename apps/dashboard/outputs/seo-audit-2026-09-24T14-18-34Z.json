{
  "root": "card_seo",
  "state": {},
  "elements": {
    "card_seo": {
      "type": "Card",
      "props": {
        "title": "SEO Audit",
        "description": "aeon.fun"
      },
      "children": [
        "alert_header",
        "sep_1",
        "section_status",
        "sep_2",
        "section_missing",
        "sep_3",
        "section_fix"
      ]
    },
    "alert_header": {
      "type": "Alert",
      "props": {
        "type": "warning",
        "message": "Sitemap incomplete and missing canonical configuration"
      }
    },
    "sep_1": {
      "type": "Separator",
      "props": {}
    },
    "section_status": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_status",
        "stat_score",
        "stat_pages",
        "text_baseline",
        "text_sitemap",
        "text_canonical"
      ]
    },
    "heading_status": {
      "type": "Heading",
      "props": {
        "text": "Current Status",
        "level": "h2"
      }
    },
    "stat_score": {
      "type": "Stat",
      "props": {
        "label": "SEO Score",
        "value": "100"
      }
    },
    "stat_pages": {
      "type": "Stat",
      "props": {
        "label": "Pages Indexed",
        "value": "1"
      }
    },
    "text_baseline": {
      "type": "Text",
      "props": {
        "text": "First run, no baseline."
      }
    },
    "text_sitemap": {
      "type": "Text",
      "props": {
        "text": "Sitemap lists only aeon.fun/ which 301 redirects to www.aeon.fun/ and is missing 14 linked pages."
      }
    },
    "text_canonical": {
      "type": "Text",
      "props": {
        "text": "Canonical configuration points bare-domain root away to www."
      }
    },
    "sep_2": {
      "type": "Separator",
      "props": {}
    },
    "section_missing": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading_missing",
        "text_missing_intro",
        "grid_missing_pages"
      ]
    },
    "heading_missing": {
      "type": "Heading",
      "props": {
        "text": "Missing Pages",
        "level": "h2"
      }
    },
    "text_missing_intro": {
      "type": "Text",
      "props": {
        "text": "14 linked pages are missing from the sitemap:"
      }
    },
    "grid_missing_pages": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "sm"
      },
      "children": [
        "link_docs",
        "link_security",
        "link_hooks",
        "link_architecture",
        "link_transparency",
        "link_ecosystem",
        "link_developers",
        "link_blog",
        "link_audits",
        "link_changelog",
        "link_about",
        "link_contact",
        "link_privacy",
        "link_terms"
      ]
    },
    "link_docs": {
      "type": "StoryLink",
      "props": {
        "title": "/docs",
        "href": "https://www.aeon.fun/docs"
      }
    },
    "link_security": {
      "type": "StoryLink",
      "props": {
        "title": "/security",
        "href": "https://www.aeon.fun/security"
      }
    },
    "link_hooks": {
      "type": "StoryLink",
      "props": {
