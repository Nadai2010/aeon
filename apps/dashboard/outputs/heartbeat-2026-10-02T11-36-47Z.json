{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Heartbeat — 2026-10-02"
      },
      "children": [
        "main-stack"
      ]
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "recovery-section",
        "sep-1",
        "stalled-section",
        "sep-2",
        "other-prs-section",
        "sep-3",
        "summary-section"
      ]
    },
    "recovery-section": {
      "type": "Alert",
      "props": {
        "type": "success",
        "title": "🟢 github-trending recovered",
        "message": "Success 2026-10-01 (cf=0). Status page back from 🔴 DEGRADED to 🟡 WATCH."
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stalled-section": {
      "type": "Alert",
      "props": {
        "type": "warning",
        "title": "🟡 STALLED: Dependabot PR #16, #17",
        "message": "Dashboard/mcp-server bumps opened 2026-10-01 ~04:40 UTC, now ~31h old — crossed the 24h stall threshold."
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "other-prs-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "other-prs-label",
        "other-prs-list"
      ]
    },
    "other-prs-label": {
      "type": "Text",
      "props": {
        "text": "ℹ️ Other open PRs (~8 days, already reported):",
        "variant": "body"
      }
    },
    "other-prs-list": {
      "type": "Text",
      "props": {
        "text": "#1, #3, #4",
        "variant": "lead"
      }
    },
    "sep-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "summary-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "summary-status-text",
        "health-stat"
      ]
    },
    "summary-status-text": {
      "type": "Text",
      "props": {
        "text": "No urgent issues, no failed/stuck skills",
        "variant": "body"
      }
    },
    "health-stat": {
      "type": "Stat",
      "props": {
        "label": "Open health issues",
        "value": "0"
      }
    }
  }
